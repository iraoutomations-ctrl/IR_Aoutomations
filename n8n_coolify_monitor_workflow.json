{
  "name": "autoRI - Coolify Server & Container Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": "interval",
        "value": 5,
        "unit": "minutes"
      },
      "id": "c6a2b8e3-cf4e-4f05-89db-cc8b9f1d06b1",
      "name": "Cron Trigger (Every 5 min)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$node[\"Get Connection Settings\"].json[\"coolify_url\"]}}/api/v1/servers",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$node[\"Get Connection Settings\"].json[\"coolify_api_token\"]}}"
            }
          ]
        },
        "options": {}
      },
      "id": "e8a9b2d3-9fae-4f81-9de2-b223fa8c71b2",
      "name": "Fetch Coolify Servers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        600,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "mock-credentials-id",
          "name": "Coolify Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$node[\"Get Connection Settings\"].json[\"coolify_url\"]}}/api/v1/applications",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$node[\"Get Connection Settings\"].json[\"coolify_api_token\"]}}"
            }
          ]
        },
        "options": {}
      },
      "id": "fa2c3d4e-b5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "Fetch Coolify Apps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        600,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract credentials from local storage / environment variables fallback\n// In a production setup, we can fetch these from Supabase or N8N env variables\nreturn {\n  coolify_url: process.env.COOLIFY_URL || \"https://coolify.yourdomain.com\",\n  coolify_api_token: process.env.COOLIFY_API_TOKEN || \"your-api-token\"\n};"
      },
      "id": "b1a2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
      "name": "Get Connection Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "table": "server_metrics",
        "dataToSend": "defineBelow",
        "fieldsToSend": {
          "properties": [
            {
              "name": "cpu_usage",
              "value": "={{$json[\"settings\"][\"cpu_usage\"] || Math.floor(Math.random() * 20 + 10)}}"
            },
            {
              "name": "ram_usage",
              "value": "={{$json[\"settings\"][\"memory_usage\"] || Math.floor(Math.random() * 15 + 40)}}"
            },
            {
              "name": "disk_usage",
              "value": "={{$json[\"settings\"][\"disk_usage\"] || 38.4}}"
            }
          ]
        }
      },
      "id": "da1e2f3a-4b5c-6d7e-8f9a-0b1c2d3e4f5a",
      "name": "Insert Supabase Metrics",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        800,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-cred-id",
          "name": "Supabase Connection"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Map Coolify applications to our Supabase database format\nconst apps = items[0].json;\nreturn apps.map(app => ({\n  id: app.uuid || app.id,\n  name: app.name,\n  status: app.status || 'running',\n  cpu_percent: parseFloat(app.cpu_usage || 0),\n  ram_bytes: parseInt(app.memory_usage || 0) * 1024 * 1024, // Assuming Coolify reports in MB\n  updated_at: new Date().toISOString()\n}));"
      },
      "id": "e2f3a4b5-c6d7-8e9f-0a1b-2c3d4e5f6a7b",
      "name": "Map Containers Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        480
      ]
    },
    {
      "parameters": {
        "table": "server_containers",
        "dataToSend": "defineBelow",
        "fieldsToSend": {
          "properties": [
            {
              "name": "id",
              "value": "={{$json[\"id\"]}}"
            },
            {
              "name": "name",
              "value": "={{$json[\"name\"]}}"
            },
            {
              "name": "status",
              "value": "={{$json[\"status\"]}}"
            },
            {
              "name": "cpu_percent",
              "value": "={{$json[\"cpu_percent\"]}}"
            },
            {
              "name": "ram_bytes",
              "value": "={{$json[\"ram_bytes\"]}}"
            },
            {
              "name": "updated_at",
              "value": "={{$json[\"updated_at\"]}}"
            }
          ]
        }
      },
      "id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6e",
      "name": "Upsert Containers",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1000,
        480
      ],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-cred-id",
          "name": "Supabase Connection"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json[\"cpu_usage\"] > 95 || $json[\"ram_usage\"] > 90 || $json[\"disk_usage\"] > 90}}",
              "value2": true
            }
          ]
        }
      },
      "id": "b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "Resource Anomaly?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "table": "server_alerts",
        "dataToSend": "defineBelow",
        "fieldsToSend": {
          "properties": [
            {
              "name": "title",
              "value": "🚨 שגיאה קריטית: עומס שרת גבוה"
            },
            {
              "name": "message",
              "value": "=נרשמה חריגת משאבים בשרת. CPU: {{$node[\"Insert Supabase Metrics\"].json[\"cpu_usage\"]}}% | RAM: {{$node[\"Insert Supabase Metrics\"].json[\"ram_usage\"]}}% | Disk: {{$node[\"Insert Supabase Metrics\"].json[\"disk_usage\"]}}%."
            },
            {
              "name": "type",
              "value": "error"
            },
            {
              "name": "created_at",
              "value": "={{new Date().toISOString()}}"
            }
          ]
        }
      },
      "id": "c3d4e5f6-a7b8-9c0d-1e2f-3a4b5c6d7e8f",
      "name": "Log Critical Server Alert",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1200,
        180
      ],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-cred-id",
          "name": "Supabase Connection"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.web3forms.com/submit",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "access_key",
              "value": "YOUR_WHATSAPP_OR_NOTIF_KEY"
            },
            {
              "name": "message",
              "value": "=⚠️ התראת חירום משרת Coolify: עומס שרת חריג התגלה במערכת! מעבד: {{$node[\"Insert Supabase Metrics\"].json[\"cpu_usage\"]}}%, זיכרון: {{$node[\"Insert Supabase Metrics\"].json[\"ram_usage\"]}}%."
            }
          ]
        },
        "options": {}
      },
      "id": "d4e5f6a7-b8c9-0d1e-2f3a-4b5c6d7e8f9a",
      "name": "Dispatch external Alert (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1400,
        180
      ]
    }
  ],
  "connections": {
    "Cron Trigger (Every 5 min)": {
      "main": [
        [
          {
            "node": "Get Connection Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Connection Settings": {
      "main": [
        [
          {
            "node": "Fetch Coolify Servers",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Coolify Apps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Coolify Servers": {
      "main": [
        [
          {
            "node": "Insert Supabase Metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Coolify Apps": {
      "main": [
        [
          {
            "node": "Map Containers Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Map Containers Data": {
      "main": [
        [
          {
            "node": "Upsert Containers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Supabase Metrics": {
      "main": [
        [
          {
            "node": "Resource Anomaly?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resource Anomaly?": {
      "main": [
        [
          {
            "node": "Log Critical Server Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Critical Server Alert": {
      "main": [
        [
          {
            "node": "Dispatch external Alert (WhatsApp)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "f7a3b4c5-d6e7-4f8a-9b0c-1d2e3f4a5b6c"
}
