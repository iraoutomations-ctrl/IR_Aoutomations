{
  "name": "autoRI - Coolify Server & Container Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes"
            }
          ]
        }
      },
      "id": "c6a2b8e3-cf4e-4f05-89db-cc8b9f1d06b1",
      "name": "Cron Trigger (Every 5 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        208,
        304
      ]
    },
    {
      "parameters": {
        "tableId": "server_metrics",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "cpu_usage",
              "fieldValue": "={{$json[\"cpu_usage\"]}}"
            },
            {
              "fieldId": "ram_usage",
              "fieldValue": "={{$json[\"ram_usage\"]}}"
            },
            {
              "fieldId": "disk_usage",
              "fieldValue": "={{$json[\"disk_usage\"]}}"
            },
            {
              "fieldId": "cpu_cores",
              "fieldValue": "={{$json[\"cpu_cores\"]}}"
            },
            {
              "fieldId": "cpu_model",
              "fieldValue": "={{$json[\"cpu_model\"]}}"
            },
            {
              "fieldId": "ram_total",
              "fieldValue": "={{$json[\"ram_total\"]}}"
            },
            {
              "fieldId": "disk_total",
              "fieldValue": "={{$json[\"disk_total\"]}}"
            }
          ]
        }
      },
      "id": "da1e2f3a-4b5c-6d7e-8f9a-0b1c2d3e4f5a",
      "name": "Insert Supabase Metrics",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        800,
        304
      ],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-cred-id",
          "name": "Supabase Connection"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Map the containers list from parsed SSH JSON to Supabase schema format\nconst containers = $json.containers || [];\nconst mapped = containers.map(c => {\n  // Normalize Docker \"Up X hours\" to standard \"running\"\n  let status = c.status || '';\n  if (status.toLowerCase().startsWith('up')) {\n    status = 'running';\n  }\n  return {\n    id: c.name,\n    name: c.name,\n    status: status,\n    cpu_percent: c.cpu_percent,\n    ram_bytes: c.ram_bytes,\n    updated_at: new Date().toISOString()\n  };\n});\nreturn [ { json: { containers: mapped } } ];"
      },
      "id": "e2f3a4b5-c6d7-8e9f-0a1b-2c3d4e5f6a7b",
      "name": "Map Containers Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        480
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json[\"cpu_usage\"] > 95 || $json[\"ram_usage\"] > 90 || $json[\"disk_usage\"] > 90}}",
              "value2": true
            }
          ]
        }
      },
      "id": "b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "Resource Anomaly?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1008,
        304
      ]
    },
    {
      "parameters": {
        "tableId": "server_alerts",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "title",
              "fieldValue": "🚨 שגיאה קריטית: עומס שרת גבוה"
            },
            {
              "fieldId": "message",
              "fieldValue": "=נרשמה חריגת משאבים בשרת. CPU: {{$node[\"Insert Supabase Metrics\"].json[\"cpu_usage\"]}}% | RAM: {{$node[\"Insert Supabase Metrics\"].json[\"ram_usage\"]}}% | Disk: {{$node[\"Insert Supabase Metrics\"].json[\"disk_usage\"]}}%."
            },
            {
              "fieldId": "type",
              "fieldValue": "error"
            },
            {
              "fieldId": "created_at",
              "fieldValue": "={{new Date().toISOString()}}"
            }
          ]
        }
      },
      "id": "c3d4e5f6-a7b8-9c0d-1e2f-3a4b5c6d7e8f",
      "name": "Log Critical Server Alert",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1200,
        192
      ],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-cred-id",
          "name": "Supabase Connection"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.web3forms.com/submit",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "access_key",
              "value": "YOUR_WHATSAPP_OR_NOTIF_KEY"
            },
            {
              "name": "message",
              "value": "=⚠️ התראת חירום משרת Coolify: עומס שרת חריג התגלה במערכת! מעבד: {{$node[\"Insert Supabase Metrics\"].json[\"cpu_usage\"]}}%, זיכרון: {{$node[\"Insert Supabase Metrics\"].json[\"ram_usage\"]}}%."
            }
          ]
        },
        "options": {}
      },
      "id": "d4e5f6a7-b8c9-0d1e-2f3a-4b5c6d7e8f9a",
      "name": "Dispatch external Alert (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1408,
        192
      ]
    },
    {
      "id": "e73d0a77-83dd-4d03-99fa-18bda535671f",
      "name": "SSH Monitor",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        400,
        304
      ],
      "parameters": {
        "resource": "command",
        "operation": "execute",
        "authentication": "privateKey",
        "command": "docker ps"
      },
      "credentials": {
        "sshPrivateKey": {
          "id": "ssh-cred-id",
          "name": "SSH Private Key account"
        }
      }
    },
    {
      "id": "f99c9c6c-2e09-419f-9058-98ffc715a7a8",
      "name": "Parse SSH Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        304
      ],
      "parameters": {
        "jsCode": "const stdout = $json.stdout;\nconst data = JSON.parse(stdout);\nreturn [ { json: data } ];"
      }
    },
    {
      "id": "ab435058-59a8-49fa-9c22-db9bbb99624f",
      "name": "Upsert Containers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1008,
        480
      ],
      "parameters": {
        "method": "POST",
        "url": "https://pjjncfoaunwugmgkaqlz.supabase.co/rest/v1/rpc/upsert_server_containers",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"containers_json\": $json.containers } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "sb_publishable_wVtgeu0jwRxQr3xUDjkz8g_00BL2jcb"
            },
            {
              "name": "Authorization",
              "value": "Bearer sb_publishable_wVtgeu0jwRxQr3xUDjkz8g_00BL2jcb"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Insert Supabase Metrics": {
      "main": [
        [
          {
            "node": "Resource Anomaly?",
