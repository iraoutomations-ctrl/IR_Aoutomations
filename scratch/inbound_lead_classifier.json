":"Google Gemini(PaLM) Api account"}}},{"parameters":{"jsCode":"let rawOutput = $input.item.json.output || \"\";\n\nfunction extractJSON(text) {\n  // תיקון ה-Regex לניקוי תגיות קוד בצורה בטוחה\n  let clean = text.replace(/```json|```/g, '').trim();\n  let startPos = clean.indexOf('{');\n  let endPos = clean.lastIndexOf('}');\n  if (startPos !== -1 && endPos !== -1) {\n    return clean.slice(startPos, endPos + 1);\n  }\n  return clean;\n}\n\nlet jsonString = extractJSON(rawOutput);\nlet leadData = {};\n\ntry {\n  leadData = JSON.parse(jsonString);\n} catch (e) {\n  leadData = {\n    lead_type: \"ספאם\",\n    client_name: \"שגיאת פענוח\",\n    client_phone: \"לא ידוע\",\n    client_email: \"לא ידוע\", // שדה חדש במקרה של שגיאה\n    source: \"לא ידוע\",\n    summary: \"ה-AI החזיר פורמט לא תקין. טקסט גולמי: \" + rawOutput.slice(0, 100)\n  };\n}\n\nreturn {\n  json: {\n    lead: leadData\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[208,-96],"id":"ae7d7c75-fd82-41fa-99da-beb3ff71b914","name":"Code in JavaScript"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"leftValue":"={{ $json.lead.lead_type }}","rightValue":"קונה","operator":{"type":"string","operation":"equals"},"id":"252c623d-fd17-4afd-bb87-79c06dd0786d"}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"0a9f0712-ceb5-44f1-b264-3892685978e5","leftValue":"={{ $json.lead.lead_type }}","rightValue":"מוכר","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"12640eaf-7c70-4009-8649-af90da43ebdd","leftValue":"={{ $json.lead.lead_type }}","rightValue":"ספאם","operator":{"type":"string","operation":"equals","name":"filter.operator.eq