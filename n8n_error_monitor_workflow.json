x 0;\">\n      <a href=\"${$json.execution.url}\" target=\"_blank\" style=\"background-color: #1890ff; color: white; padding: 12px 24px; text-decoration: none; font-weight: bold; border-radius: 4px; display: inline-block; box-shadow: 0 2px 4px rgba(24,144,255,0.2);\">כניסה ישירה לפרטי הריצה ב-n8n 🔍</a>\n    </div>\n    \n    <p style=\"font-size: 13px; color: #888888; text-align: center; margin-top: 35px; border-top: 1px solid #f0f0f0; padding-top: 15px;\">\n      נשלח אוטומטית על ידי מערכת הניטור של autoRI-studio\n    </p>\n  </div>\n</div>` }};",
